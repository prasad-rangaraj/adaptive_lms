# Environment variables - copy this to .env and fill in your values

# --- Database ---
POSTGRES_USER=lms_admin
POSTGRES_PASSWORD=lms_secret_password
POSTGRES_DB=adaptive_lms
DATABASE_URL=postgresql://lms_admin:lms_secret_password@localhost:5432/adaptive_lms

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- OpenAI ---
OPENAI_API_KEY=sk-...your-api-key-here...

# --- S3 / MinIO (for file storage) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=lms-media

# --- App ---
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
